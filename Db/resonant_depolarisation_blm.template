# ------ Processed data
# e.g. SR00RDP01:BLM04_B_BEAM_LOSS_RATIO
record (waveform, "$(DEVICE):$(BLM)_$(CHANNEL)_BEAM_LOSS_RATIO") {
    field (DESC, "Normalised ratio of beam loss over split ADC windows")
    field (SCAN, "Passive")
    field (FTVL, "DOUBLE")
    field (NELM, "19195")
    field (EGU,  "")
    field (PREC, "3")
    field (LOPR, "0.0")
    field (HOPR, "10.0")
}

