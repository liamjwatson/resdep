# --------------------------------------------------------------------- Control
# Read by the IocApi
# 
record (bo, "$(DEVICE):RUN_CMD") {
    field (DESC, "Start resonant depolarisation")
    field (SCAN, "Passive")
    field (HIGH, "1.0")
    field (ZNAM, "No Action")
    field (ONAM, "Start")
}

record (bo, "$(DEVICE):ABORT_CMD") {
    field (DESC, "Abort resonant depolarisation")
    field (SCAN, "Passive")
    field (HIGH, "1.0")
    field (ZNAM, "No Action")
    field (ONAM, "Start")
}

record (mbbo, "$(DEVICE):SCAN_TYPE_CMD") {
    field (DESC, "ResDep requested scan type")
    field (SCAN, "Passive")
    field (ZRST, "NONE")
    field (ONST, "AUTOMATIC")
    field (TWST, "NORMAL")
    field (THST, "WIDE")
}

# -------------------------------------------------------------------- Feedback

# ----- Results
record (ai, "$(DEVICE):BEAM_ENERGY") {
    field(DESC, "Resonant depolarisation beam energy measurement")
    field (SCAN, "Passive")
    field(PREC, "6")
    field(EGU, "GeV")
}

record (ai, "$(DEVICE):BEAM_ENERGY_TWOSTD") {
    field(DESC, "ResDep beam energy error to two standard deviations")
    field (SCAN, "Passive")
    field(PREC, "6")
    field(EGU, "GeV")
}

# Example: "3.03138 GeV ± 10 keV"
record (stringin, "(DEVICE):BEAM_ENERGY_FORMATTED") {
    field(DESC, "Formatted beam energy string")
}

record (ai, "$(DEVICE):PROGRESS") {
    field(DESC, "Resonant depolarisation progress")
    field (SCAN, "Passive")
    field(PREC, "1")
    field(EGU, "%")
    field(ADEL, "0.9")
    field(MDEL, "0.9")
}

# ---- Diagnostics
record (mbbi, "$(DEVICE):STATE") {
    field (DESC, "Resonant depolarisation state")
    field (SCAN, "Passive")
    field (ZRST, "READY")
    field (ONST, "ABORTED")
    field (TWST, "INITIALISING")
    field (THST, "RUNNING")
}

record (stringin, "(DEVICE):ERROR_MSG") {
    field(DESC, "Detailied error test")
}

record (mbbi, "$(DEVICE):SCAN_TYPE") {
    field (DESC, "ResDep requested scan type")
    field (SCAN, "Passive")
    field (ZRST, "NONE")
    field (ONST, "AUTOMATIC")
    field (TWST, "NORMAL")
    field (THST, "WIDE")
}

record (mbbi, "$(DEVICE):RUN_INHIBIT_STATUS") {
    field (DESC, "Able to run status")
    field (SCAN, "Passive")
    field (ZRST, "ABLE_TO_RUN")
    field (ONST, "PVS_NOT_CONNECTED")
    field (TWST, "NOT_USER_BEAM")
    field (THST, "NOT_ENOUGH_CURRENT")
    field (FRST, "RECENT_WIGGLER_RAMP")
    field (FVST, "RECENT_BEAM_INJECTION")
}

