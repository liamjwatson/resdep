# --------------------------------------------------------------------- Control
# Read by the IocApi
# 
record (bo, "$(DEVICE):RUN_CMD") {
    field (DESC, "Start resonant depolarisation")
    field (SCAN, "Passive")
    field (HIGH, "1.0")
    field (ZNAM, "No Action")
    field (ONAM, "Start")
}

record (bo, "$(DEVICE):ABORT_CMD") {
    field (DESC, "Abort resonant depolarisation")
    field (SCAN, "Passive")
    field (HIGH, "1.0")
    field (ZNAM, "No Action")
    field (ONAM, "Start")
}

record (mbbo, "$(DEVICE):SCAN_TYPE_CMD") {
    field (DESC, "ResDep requested scan type")
    field (SCAN, "Passive")
    field (ZRST, "NONE")
    field (ONST, "AUTOMATIC")
    field (TWST, "NORMAL")
    field (THST, "WIDE")
}

record (ao, "$(DEVICE):AUTOMATIC_SCAN_DELAY") {
    field (DESC, "Delay between automatic scans")
    field (SCAN, "Passive")
    field (VAL,  "2")
    field (PREC, "1")
    field (EGU, "hours")
    field (DRVL, "1.0")
    field (DRVH, "72.0")
    field (ADEL, "0.1")
    field (MDEL, "0.1")
}

# -------------------------------------------------------------------- Feedback

# ----- Results
record (ai, "$(DEVICE):BEAM_ENERGY") {
    field (DESC, "Resonant depolarisation beam energy measurement")
    field (SCAN, "Passive")
    field (PREC, "6")
    field (EGU, "GeV")
}

record (ai, "$(DEVICE):BEAM_ENERGY_ERROR_TWOSTD") {
    field (DESC, "ResDep beam energy error to two standard deviations")
    field (SCAN, "Passive")
    field (PREC, "6")
    field (EGU, "GeV")
}

# Example: "3.03138 GeV ± 10 keV"
record (stringin, "(DEVICE):BEAM_ENERGY_FORMATTED") {
    field (DESC, "Formatted beam energy string")
}

record (ai, "$(DEVICE):PROGRESS") {
    field (DESC, "Resonant depolarisation progress")
    field (SCAN, "Passive")
    field (PREC, "1")
    field (EGU,  "%")
    field (DRVL, "0.0")
    field (DRVH, "100.0")
}

record (ai, "$(DEVICE):ESTIMATED_POLARISATION") {
    field (DESC, "Estimate of beam polarisation")
    field (SCAN, "Passive")
    field (PREC, "3")
    field (EGU,  "%")
    field (ADEL, "0.9")
    field (MDEL, "0.9")
}

record (ai, "$(DEVICE):AUTOMATIC_SCAN_COUNTDOWN") {
    field (DESC, "Countdown to next ResDep scan")
    field (SCAN, "Passive")
    field (PREC, "0")
    field (EGU,  "seconds")
    field (LOPR, "0.0")
    field (HOPR, "259200.0")     # 72 hours
    field (ADEL, "0.5")
    field (MDEL, "0.5")
}

# ----------------------------------------------------------------- Diagnostics
record (mbbi, "$(DEVICE):STATE") {
    field (DESC, "Resonant depolarisation state")
    field (SCAN, "Passive")
    field (ZRST, "READY")
    field (ONST, "ABORTED")
    field (TWST, "INITIALISING")
    field (THST, "RUNNING")
    field (FRST, "FINISHED")
}

record (stringin, "(DEVICE):STATUS_MSG") {
    field (DESC, "Detailied experiment status message")
}

record (mbbi, "$(DEVICE):RUN_INHIBIT_STATUS") {
    field (DESC, "Able to run status")
    field (SCAN, "Passive")
    field (ZRST, "ABLE_TO_RUN")
    field (ONST, "PVS_NOT_CONNECTED")
    field (TWST, "NOT_USER_BEAM")
    field (THST, "NOT_ENOUGH_CURRENT")
    field (FRST, "RECENT_WIGGLER_RAMP")
    field (FVST, "RECENT_BEAM_INJECTION")
    field (SXST, "BEAM_NOT_POLARISED")
}

record (mbbi, "$(DEVICE):SCAN_TYPE") {
    field (DESC, "ResDep scan type")
    field (SCAN, "Passive")
    field (ZRST, "NONE")
    field (ONST, "AUTOMATIC")
    field (TWST, "NORMAL")
    field (THST, "WIDE")
}

record (stringin, "(DEVICE):ERROR_MSG") {
    field (DESC, "Detailied error test")
}

# -------------------------------------------------------------- Processed data
# these are the "x-axes" for the beam_loss ratio data waveforms (y-axis)
# see Db/resonant_depolarisation_blm.template
record (waveform, "$(DEVICE):SWEEP_FREQUENCIES") {
    field (DESC, "ResDep frequency sweep")
    field (SCAN, "Passive")
    field (FTVL, "DOUBLE")
    field (NELM, "19195")
    field (EGU,  "kHz")
    field (PREC, "3")
    field (LOPR, "0.0")
    field (HOPR, "10.0")
}

record (waveform, "$(DEVICE):SWEEP_ENERGIES") {
    field (DESC, "ResDep energy sweep")
    field (SCAN, "Passive")
    field (FTVL, "DOUBLE")
    field (NELM, "19195")
    field (EGU,  "GeV")
    field (PREC, "3")
    field (LOPR, "0.0")
    field (HOPR, "10.0")
}

